# Copy this file to .env or export these variables in your shell before running mitmproxy.

# mitmproxy listener.
export PRODUCTIVE_PROXY_LISTEN_HOST="0.0.0.0"
export PRODUCTIVE_PROXY_LISTEN_PORT="8080"

# Proxy Basic authentication.
# Set to "false" when a client does not support proxy auth.
export PRODUCTIVE_PROXY_AUTH_ENABLED="true"
# Required only when auth is enabled. Do not use ':' in either value.
export PRODUCTIVE_PROXY_AUTH_USERNAME="productive"
export PRODUCTIVE_PROXY_AUTH_PASSWORD="change-me"

# Files written by the policy addon.
export PRODUCTIVE_PROXY_STATE_PATH="./data/productive_proxy_state.json"
export PRODUCTIVE_PROXY_EVENT_LOG_PATH="./data/productive_proxy_events.jsonl"

# Reddit tracking.
# A Reddit session is considered active while Reddit requests are less than this many seconds apart.
export PRODUCTIVE_PROXY_REDDIT_IDLE_SECONDS="300"
export PRODUCTIVE_PROXY_REDDIT_HOST_SUFFIXES="reddit.com,www.reddit.com,old.reddit.com,new.reddit.com,redd.it"

# YouTube Shorts blocking.
export PRODUCTIVE_PROXY_YOUTUBE_HOST_SUFFIXES="youtube.com,www.youtube.com,m.youtube.com,youtube-nocookie.com,www.youtube-nocookie.com"
export PRODUCTIVE_PROXY_YOUTUBE_SHORTS_PATH_MARKERS="/shorts,/youtubei/v1/reel,/api/stats/shorts"
