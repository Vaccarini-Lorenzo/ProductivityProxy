# Optional dev helper config for scripts/run_mitm.sh.
# The Tauri app stores these settings in its app data instead of using .env.

# mitmproxy listener.
export PRODUCTIVE_PROXY_LISTEN_HOST="127.0.0.1"
export PRODUCTIVE_PROXY_LISTEN_PORT="8080"

# Proxy Basic authentication.
# Set to "false" when a client does not support proxy auth.
export PRODUCTIVE_PROXY_AUTH_ENABLED="false"
# Required only when auth is enabled. Do not use ':' in either value.
export PRODUCTIVE_PROXY_AUTH_USERNAME="productive"
export PRODUCTIVE_PROXY_AUTH_PASSWORD="change-me"

# Graph policy config and runtime files.
export PRODUCTIVE_PROXY_CONFIG_PATH="./src/proxy/defaults/default_config.json"
export PRODUCTIVE_PROXY_STATE_PATH="./data/productive_proxy_state.json"
export PRODUCTIVE_PROXY_EVENT_LOG_PATH="./data/productive_proxy_events.jsonl"
